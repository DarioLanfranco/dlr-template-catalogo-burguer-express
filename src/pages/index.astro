---
import Layout from "../layouts/Layout.astro";
import LiveStatus from "../components/sections/LiveStatus.astro";
import Hero from "../components/sections/Hero.astro";
import ServiceBanner from "../components/sections/ServiceBanner.astro";
import CategoryBar from "../components/CategoryBar.astro";
import Marquee from "../components/sections/Marquee.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ProductsCarousel from "../components/ProductsCarousel.astro";
import PromoAndCheckout from "../components/PromoAndCheckout.astro";
import OrderCheckout from "../components/cart/OrderCheckout.astro";
import FriesBanner from "../components/sections/FriesBanner.astro";
import TakeAwayBanner from "../components/sections/TakeAwayBanner.astro";
import ReviewsSection from "../components/sections/ReviewsSection.astro";
import About from "../components/sections/About.astro";
import Sucursal from "../components/sections/Sucursal.astro";
import FAQSection from "../components/sections/FAQSection.astro";
import Footer from "../components/sections/Footer.astro";
import { siteConfig } from "../config/site-config";
import { MENU_DATA } from "../data/menu";

const { about, contact, siteName, social } = siteConfig;
const BASE = import.meta.env.BASE_URL;
---

<Layout title={siteName}>
  <LiveStatus />
  <Hero />
  <ServiceBanner />
  <CategoryBar />
  <Marquee />
  <SectionHeader title="LOS MÁS PEDIDOS" link={BASE + "menu/"} />
  <ProductsCarousel products={MENU_DATA} />
  <PromoAndCheckout />
  <OrderCheckout phoneNumber={contact.whatsappNumber} siteName={siteName} />
  <FriesBanner />
  <TakeAwayBanner address={contact.address} />
  <ReviewsSection />
  <About
    subtitle={about.history.subtitle}
    title={about.history.title}
    text1={about.history.text1}
    text2={about.history.text2}
  />
  <Sucursal
    businessHours={contact.businessHours}
    address={contact.address}
    googleMapsLink={contact.googleMapsLink}
    facebookUrl={social.facebook}
    instagramUrl={social.instagram}
    xUrl={social.twitter}
  />
  <FAQSection />
  <Footer slot="footer" siteName={siteName} />
</Layout>
