---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import About from "../components/sections/About.astro";
import Sucursal from "../components/sections/Sucursal.astro";
import Footer from "../components/sections/Footer.astro";
import { siteConfig } from "../config/site-config";

const { about, contact, siteName, social } = siteConfig;
---

<Layout title={"Conócenos — " + siteName}>
  <PageHeader
    highlight="PEPÓN"
    title="ES NUESTRA PASIÓN"
    description="Una rotisería que nació del amor por la comida bien hecha, sin vueltas ni pretensiones."
    highlightPos="first"
  />

  <About
    subtitle={about.history.subtitle}
    title={about.history.title}
    text1={about.history.text1}
    text2={about.history.text2}
  />

  <Sucursal
    businessHours={contact.businessHours}
    address={contact.address}
    googleMapsLink={contact.googleMapsLink}
    facebookUrl={social.facebook}
    instagramUrl={social.instagram}
    xUrl={social.twitter}
  />

  <Footer slot="footer" siteName={siteName} />
</Layout>
