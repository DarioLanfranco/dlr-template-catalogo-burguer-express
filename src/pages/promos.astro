---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import PromoAndCheckout from "../components/PromoAndCheckout.astro";
import Footer from "../components/sections/Footer.astro";
import { siteConfig } from "../config/site-config";

const { siteName } = siteConfig;
---

<Layout title={"Promos — " + siteName}>
  <PageHeader
    title="OFERTAS"
    highlight="BRUTALES"
    description="Combos exclusivos, precios que rompen el molde y promos rotativas para que siempre vuelvas por más."
  />

  <!-- Combo 1 — Pepón -->
  <PromoAndCheckout />

  <!--
    Combo 2 — placeholder para futura promo rotativa.
    Se duplicará el patrón de PromoAndCheckout con datos
    distintos cuando el backend de promos esté listo.
  -->
  <section class="promo-card">
    <div class="promo-card-left">
      <span class="promo-card-sticker">PRÓXIMAMENTE</span>
      <h2 class="promo-card-title">
        NUEVA<br />
        <span class="promo-card-highlight">PROMO</span>
      </h2>
      <p class="promo-card-desc">
        Muy pronto una oferta que te va a volar la cabeza.
        Seguinos en redes para enterarte primero.
      </p>
    </div>
    <div class="promo-card-right">
      <div class="promo-card-placeholder">
        <span>?</span>
      </div>
    </div>
  </section>

  <Footer slot="footer" siteName={siteName} />
</Layout>

<style>
  /* ── Promo card placeholder ── */

  .promo-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: center;
    max-width: 1400px;
    margin: 0 auto 2rem;
    padding: 0 2rem;
  }

  .promo-card-left {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .promo-card-sticker {
    display: inline-flex;
    align-self: flex-start;
    padding: 0.35rem 0.75rem;
    background: var(--color-text-base);
    color: var(--color-bg);
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    border: var(--border-brutal);
    transform: rotate(-2deg);
    transform-origin: left center;
    white-space: nowrap;
  }

  .promo-card-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    letter-spacing: -0.04em;
    line-height: 0.85;
    color: var(--color-text-base);
    text-transform: uppercase;
    margin: 0;
  }

  .promo-card-highlight {
    color: var(--color-primary);
  }

  .promo-card-desc {
    font-size: clamp(0.85rem, 1.4vw, 1.05rem);
    font-weight: 600;
    color: var(--color-text-base);
    opacity: 0.8;
    line-height: 1.5;
    margin: 0;
  }

  .promo-card-right {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .promo-card-placeholder {
    width: 100%;
    max-width: 360px;
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-card-base);
    border: var(--border-brutal);
    box-shadow: var(--shadow-brutal);
  }

  .promo-card-placeholder span {
    font-family: var(--font-display);
    font-size: 4rem;
    color: var(--color-text-base);
    opacity: 0.2;
  }

  @media (max-width: 768px) {
    .promo-card {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 0 1.25rem;
    }

    .promo-card-placeholder {
      max-width: 280px;
    }
  }
</style>
