---
import { CATEGORIAS } from "../data/menu";

interface Props {
  filterable?: boolean;
}

const { filterable = false } = Astro.props;
const allLabel = "TODAS";
---

<nav class="category-carousel" aria-label="Categorías del menú">
  {filterable && (
    <button class="category-btn is-active" aria-pressed="true">
      <span class="category-label">{allLabel}</span>
    </button>
  )}
  {
    CATEGORIAS.map((cat, i) => (
      <button
        class={`category-btn${!filterable && i === 0 ? " is-active" : ""}`}
        aria-pressed={!filterable && i === 0 ? "true" : "false"}
        data-category-id={cat.id}
      >
        <img
          src={cat.icon.src}
          alt=""
          class="category-icon"
          width="28"
          height="28"
          loading="eager"
        />
        <span class="category-label">{cat.nombre.toUpperCase()}</span>
      </button>
    ))
  }
</nav>

<style>
  .category-carousel {
    display: flex;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    gap: 12px;
    padding: 0.75rem 1rem;
  }

  .category-carousel::-webkit-scrollbar {
    display: none;
  }

  .category-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 96px;
    height: 96px;
    border: var(--border-brutal);
    border-radius: 1rem;
    background: var(--color-card-base);
    cursor: pointer;
    padding: 0.75rem;
    gap: 0.4rem;
    scroll-snap-align: start;
    transition:
      background-color 0.15s ease,
      color 0.15s ease,
      transform 0.15s var(--ease-spring);
    -webkit-tap-highlight-color: transparent;
  }

  .category-btn:active {
    transform: scale(0.94);
  }

  .category-btn:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .category-btn.is-active {
    background: var(--color-primary);
  }

  .category-btn.is-active .category-label {
    color: #FFFFFF;
  }

  .category-btn.is-active .category-icon {
    filter: brightness(0) saturate(100%) invert(1);
  }

  .category-icon {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    display: block;
    pointer-events: none;
  }

  [data-theme="dark"] .category-icon {
    filter: invert(1);
  }

  .category-label {
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--color-text-base);
    text-transform: uppercase;
    text-align: center;
    line-height: 1.2;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .category-carousel {
      justify-content: center;
      overflow-x: visible;
      padding: 1rem 2rem;
    }
  }

  @media (max-width: 768px) {
    .category-carousel {
      padding: 0.75rem 1.25rem;
    }

    .category-btn {
      width: 85px;
      height: 85px;
      gap: 0.3rem;
      padding: 0.5rem;
    }

    .category-icon {
      width: 24px;
      height: 24px;
    }

    .category-label {
      font-size: 0.5625rem;
    }
  }
</style>

<script>
  const nav = document.querySelector(".category-carousel");
  const hasAllButton = nav?.querySelector(".category-btn:not([data-category-id])");
  if (nav && hasAllButton) {
    nav.addEventListener("click", (e: Event) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;
      const btn = target.closest(".category-btn") as HTMLButtonElement | null;
      if (!btn) return;

      nav.querySelectorAll(".category-btn").forEach((b) => {
        b.classList.remove("is-active");
        b.setAttribute("aria-pressed", "false");
      });
      btn.classList.add("is-active");
      btn.setAttribute("aria-pressed", "true");

      const categoryId = btn.getAttribute("data-category-id") || "";
      const products = document.querySelectorAll("[data-category]");
      products.forEach((el) => {
        const match = !categoryId || el.getAttribute("data-category") === categoryId;
        (el as HTMLElement).style.display = match ? "" : "none";
      });
    });
  }
</script>
