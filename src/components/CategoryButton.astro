---
/*
 *  ──────────────────────────────────────────────
 *  ＣＡＴＥＧＯＲＹ  ＢＵＴＴＯＮ  —  Anatomía
 *  Estado inactivo (PIZZAS, EMPANADAS, etc.)
 *
 *  Referencia Tailwind (no instalado en el proyecto):
 *    flex flex-col items-center justify-between
 *    w-24 h-24 flex-shrink-0
 *    rounded-2xl border-2 border-[#121212]
 *    bg-white / var(--color-card-base)
 *    p-3 gap-0
 *    transition-all duration-150
 *    active:scale-95
 *    max-w-[96px]
 *  ──────────────────────────────────────────────
 */

interface Props {
  iconSrc: string;
  label: string;
  active?: boolean;
  pressed?: boolean;
}

const { iconSrc, label, active = false, pressed = false } = Astro.props;
---

<button
  class:list={["category-btn", { "is-active": active }]}
  aria-pressed={pressed}
>
  <!-- SVG icon  w-10 h-10  (28px en mobile) -->
  <img
    src={iconSrc}
    alt=""
    class="category-icon"
    width="28"
    height="28"
    loading="eager"
  />

  <!-- Label  text-[10px] font-bold tracking-widest -->
  <span class="category-label">{label}</span>
</button>

<style>
  /* ==============================================
   *  ───  BOTÓN INACTIVO  ───
   *  ============================================*/

  .category-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;

    width: 96px;
    height: 96px;
    flex-shrink: 0;

    border-radius: 1rem;

    /*
     * border-2 border-[#121212] • 2px theme-aware.
     * Evaluación activo: black-on-red (light) y white-on-red (dark)
     * tienen contraste excelente → no hereda --border-brutal (3px).
     */
    border: 2px solid var(--color-text-base);

    background: var(--color-card-base);
    padding: 0.75rem;

    /*
     * Transiciones: color y fondo fluyen al toggle .is-active
     * La transform escala en :active (click) se mantiene aparte.
     */
    transition:
      background-color 0.15s ease,
      color 0.15s ease,
      transform 0.15s var(--ease-spring);

    -webkit-tap-highlight-color: transparent;
    cursor: pointer;
  }

  /*
   * :active → scale(0.94)
   * Hundimiento físico común a ambos estados.
   */
  .category-btn:active {
    transform: scale(0.94);
  }

  .category-btn:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  /* ==============================================
   *  ───  ESTADO ACTIVO  .is-active  ───
   *  Inversión completa: fondo rojo, texto blanco,
   *  icono blanco, bordes 2px dinámicos.
   *  ============================================*/

  .category-btn.is-active {
    /* Fondo → Kétchup Red */
    background-color: var(--color-primary);

    /*
     * Borde: se mantiene igual que el base (2px dinámico).
     * Evaluación: black-on-red (light) y white-on-red (dark)
     * tienen alto contraste → no necesita --border-brutal (3px).
     */
    border-color: var(--color-text-base);

    /* Color de label → blanco puro */
    color: #FFFFFF;
  }

  /*
   * Label dentro del botón activo → blanco.
   * Pisa el color-base heredado del label inactivo.
   */
  .category-btn.is-active .category-label {
    color: #FFFFFF;
  }

  /*
   * Icono SVG dentro del botón activo → blanco.
   *
   * ⚠️ Nota técnica: los SVGs se importan como <img> (proyecto actual)
   * y traen fill="#000000" hardcodeado en el archivo .svg.
   * Con <img> no podemos usar fill: currentColor / stroke: currentColor.
   * La solución es CSS filter que convierte negro→blanco:
   *
   *   brightness(0)       → aplana todo a negro
   *   saturate(100%)      → retiene saturación (no-op tras brightness(0))
   *   invert(1)           → invierte negro → blanco
   *
   * Para una solución más limpia a futuro: pasar los SVGs a inline
   * dentro del componente y reemplazar fill="#000000" por fill="currentColor".
   * Eso permitiría usar simplemente color: #FFFFFF en el padre y
   * eliminaría la dependencia de filter.
   */
  .category-btn.is-active .category-icon {
    filter: brightness(0) saturate(100%) invert(1);
  }

  /* ==============================================
   *  ───  SVG DARK MODE (inactivo)  ───
   *  ============================================*/

  [data-theme="dark"] .category-icon {
    filter: invert(1);
  }

  /*
   * Cuando está activo en dark mode, el filter del
   * activo (brightness(0) invert(1)) ya produce blanco
   * sin importar el tema → no necesita override.
   */

  /* ==============================================
   *  ───  ICONO Y LABEL (base)  ───
   *  ============================================*/

  .category-icon {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    display: block;
    pointer-events: none;
  }

  .category-label {
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--color-text-base);
    text-transform: uppercase;
    text-align: center;
    line-height: 1.2;
    pointer-events: none;
  }

  /* ==============================================
   *  MOBILE  (≤768px)
   *  ============================================*/

  @media (max-width: 768px) {
    .category-btn {
      width: 85px;
      height: 85px;
      padding: 0.5rem;
      gap: 0.3rem;
    }

    .category-icon {
      width: 24px;
      height: 24px;
    }

    .category-label {
      font-size: 0.5625rem;
    }
  }
</style>
