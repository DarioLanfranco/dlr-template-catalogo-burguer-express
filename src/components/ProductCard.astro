---
/*
 *  Uso en grid:
 *
 *  import { MENU_DATA } from "../data/menu";
 *  import ProductCard from "../components/ProductCard.astro";
 *
 *  <section class="product-grid">
 *    {MENU_DATA.filter((p) => p.disponible).map((p) => (
 *      <ProductCard producto={p} />
 *    ))}
 *  </section>
 *
 *  <style>
 *    .product-grid {
 *      display: grid;
 *      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
 *      gap: 1.5rem;
 *      padding: 2rem;
 *      max-width: 1400px;
 *      margin: 0 auto;
 *    }
 *
 *    @media (max-width: 768px) {
 *      .product-grid {
 *        grid-template-columns: 1fr;
 *        padding: 1.25rem;
 *        gap: 1rem;
 *      }
 *    }
 *  </style>
 */

import { Image } from "astro:assets";
import type { Producto, ProductoTag } from "../data/menu";

interface Props {
  producto: Producto;
}

const { producto } = Astro.props;

const tagConfig: Record<ProductoTag, { bg: string; color: string }> = {
  "BEST SELLER": { bg: "var(--color-primary)", color: "#FFFFFF" },
  NUEVA: { bg: "var(--color-secondary)", color: "#121212" },
  "CLÁSICA": { bg: "var(--color-text-base)", color: "var(--color-bg)" },
};

function formatPrice(price: number): string {
  return "$ " + price.toLocaleString("es-AR");
}
---

<article class="product-card">
  {producto.tag && (
    <span
      class="product-tag"
      style={{
        background: tagConfig[producto.tag].bg,
        color: tagConfig[producto.tag].color,
      }}
    >
      {producto.tag}
    </span>
  )}

  <div class="product-image">
    <Image
      src={producto.imagen}
      alt={producto.nombre}
      width={600}
      height={400}
      format="webp"
      quality={75}
      loading="lazy"
    />
  </div>

  <div class="product-body">
    <h3 class="product-title">{producto.nombre.toUpperCase()}</h3>
    <p class="product-desc">{producto.descripcion}</p>
    <span class="product-price">{formatPrice(producto.precio)}</span>
  </div>

  <div class="qty-selector">
    <button class="qty-btn qty-minus" aria-label="Reducir cantidad">−</button>
    <span class="qty-count" aria-label="Cantidad">1</span>
    <button class="qty-btn qty-plus" aria-label="Aumentar cantidad">+</button>
  </div>
</article>

<style>
  /* ==============================================
   *  PRODUCT CARD — PEPÓN
   *  Brutalista, theme-aware, con selector qty
   *  ============================================*/

  .product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-card-base);
    border: var(--border-brutal);
    box-shadow: var(--shadow-brutal);
    overflow: hidden;
  }

  /* ── Tag flotante ── */

  .product-tag {
    position: absolute;
    top: 0.75rem;
    left: -0.25rem;
    z-index: 2;
    padding: 0.3rem 0.75rem;
    font-family: var(--font-display);
    font-size: 0.625rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border: var(--border-brutal);
    transform: rotate(-2deg);
    transform-origin: left center;
    white-space: nowrap;
    pointer-events: none;
  }

  /* ── Imagen ── */

  .product-image {
    width: 100%;
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }

  .product-image img,
  .product-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Cuerpo ── */

  .product-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem 1.25rem;
    flex: 1;
  }

  .product-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--color-text-base);
    text-transform: uppercase;
    margin: 0;
  }

  .product-desc {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text-base);
    opacity: 0.7;
    margin: 0;
    flex: 1;
  }

  .product-price {
    font-family: var(--font-display);
    font-size: 1.375rem;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--color-primary);
    margin-top: auto;
  }

  /* ── Selector de cantidad ── */

  .qty-selector {
    display: flex;
    align-items: center;
    border-top: var(--border-brutal);
    height: 44px;
  }

  .qty-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    height: 100%;
    border: none;
    background: transparent;
    color: var(--color-text-base);
    font-size: 1.25rem;
    font-weight: 700;
    cursor: pointer;
    transition:
      background 0.15s var(--ease-spring);
  }

  .qty-btn:active {
    background: color-mix(in srgb, var(--color-text-base) 10%, transparent);
  }

  .qty-btn:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: -2px;
  }

  .qty-plus {
    background: var(--color-primary);
    color: #FFFFFF;
    font-size: 1.375rem;
  }

  .qty-plus:active {
    background: color-mix(in srgb, var(--color-primary) 80%, black);
  }

  .qty-count {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 100%;
    font-size: 1rem;
    font-weight: 800;
    color: var(--color-text-base);
    background: var(--color-bg);
    border-left: var(--border-brutal);
    border-right: var(--border-brutal);
    flex-shrink: 0;
  }

  /* ----------------------------------------------
   *  Mobile
   *  --------------------------------------------*/

  @media (max-width: 768px) {
    .product-body {
      padding: 0.75rem 1rem;
      gap: 0.35rem;
    }

    .product-title {
      font-size: 1rem;
    }

    .product-price {
      font-size: 1.125rem;
    }

    .qty-selector {
      height: 40px;
    }
  }
</style>
