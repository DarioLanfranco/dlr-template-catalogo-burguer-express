---
import { Image } from "astro:assets";
import type { Producto } from "../data/menu";

interface Props {
  producto: Producto;
}

const { producto } = Astro.props;

function formatPrice(price: number): string {
  return "$ " + price.toLocaleString("es-AR");
}
---

<article class="product-card" data-category={producto.categoria}>
  {producto.tag && (
    <div class="card-tag">
      {producto.tag}
    </div>
  )}

  <div class="card-image-wrapper">
    <Image
      src={producto.imagen}
      alt={producto.nombre}
      width={600}
      height={400}
      format="webp"
      quality={75}
      loading="lazy"
    />
  </div>

  <div class="card-body">
    <h3 class="product-title">{producto.nombre.toUpperCase()}</h3>
    <p class="product-desc">{producto.descripcion}</p>
    <span class="product-price">{formatPrice(producto.precio)}</span>
  </div>

  <div class="quantity-selector">
    <button class="qty-btn btn-minus" aria-label="Reducir cantidad">−</button>
    <span class="quantity-display" aria-label="Cantidad">1</span>
    <button class="qty-btn btn-plus" aria-label="Aumentar cantidad">+</button>
  </div>
</article>

<style>
  /* ==============================================
   *  PRODUCT CARD — PEPÓN
   *  Tarjeta individual para carrusel/grid.
   *  Brutalista, theme-aware, con tag flotante,
   *  imagen optimizada y selector de cantidad.
   *  ============================================*/

  .product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 260px;
    flex-shrink: 0;
    scroll-snap-align: start;
    background-color: var(--color-card-base);
    border: var(--border-brutal);
    box-shadow: var(--shadow-brutal);
    border-radius: 0.75rem;
    overflow: hidden;
  }

  /* ── Tag flotante ── */

  .card-tag {
    position: absolute;
    top: -8px;
    left: 8px;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    padding: 2px 8px;
    border-radius: 4px;
    font-family: var(--font-display);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.04em;
    line-height: 1.4;
    text-transform: uppercase;
    white-space: nowrap;
    transform: rotate(-3deg);
    transform-origin: left center;
    pointer-events: none;

    /* Inversión theme-aware:
     *   light → bg #121212, text #FDFBF7
     *   dark  → bg #FFFFFF,  text #121212
     */
    background-color: var(--color-text-base);
    color: var(--color-bg);
    border: 1.5px solid var(--color-text-base);
  }

  /* ── Imagen ── */

  .card-image-wrapper {
    width: 100%;
    height: 150px;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }

  .card-image-wrapper img,
  .card-image-wrapper :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Cuerpo ── */

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.75rem 1rem 0.5rem;
    flex: 1;
  }

  .product-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--color-text-base);
    text-transform: uppercase;
    margin: 0;
  }

  .product-desc {
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-text-base);
    opacity: 0.7;
    margin: 0;
    flex: 1;
  }

  .product-price {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--color-primary);
    margin-top: auto;
  }

  /* ── Selector de cantidad ── */

  .quantity-selector {
    display: flex;
    flex-direction: row;
    align-items: center;
    width: 100%;
    border: var(--border-brutal);
    border-radius: 0.5rem;
    overflow: hidden;
    margin: 0 1rem 1rem;
    width: calc(100% - 2rem);
  }

  .qty-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    height: 36px;
    border: none;
    background: transparent;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-base);
    cursor: pointer;
    transition: transform 0.1s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .qty-btn:active {
    transform: scale(0.95);
  }

  .qty-btn:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: -2px;
  }

  .quantity-display {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 36px;
    font-size: 0.875rem;
    font-weight: 800;
    background-color: #FFFFFF;
    color: #121212;
    border-left: var(--border-brutal);
    border-right: var(--border-brutal);
    flex-shrink: 0;
  }

  .btn-plus {
    background-color: var(--color-primary);
    color: #FFFFFF;
    font-size: 1.25rem;
  }

  /* ----------------------------------------------
   *  Mobile
   *  --------------------------------------------*/

  @media (max-width: 768px) {
    .product-card {
      width: 240px;
    }

    .card-image-wrapper {
      height: 130px;
    }

    .card-body {
      padding: 0.6rem 0.75rem 0.4rem;
      gap: 0.3rem;
    }

    .product-title {
      font-size: 1rem;
    }

    .product-desc {
      font-size: 0.6875rem;
    }

    .product-price {
      font-size: 1.125rem;
    }

    .quantity-selector {
      margin: 0 0.75rem 0.75rem;
      width: calc(100% - 1.5rem);
    }

    .qty-btn,
    .quantity-display {
      height: 32px;
    }

    .quantity-display {
      width: 2.25rem;
      font-size: 0.8125rem;
    }
  }
</style>
