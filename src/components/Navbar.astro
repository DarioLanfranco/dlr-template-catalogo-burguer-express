---
import ThemeToggle from "./common/ThemeToggle.astro";
import "./Navbar.css";
---

<nav class="navbar" aria-label="Navegación principal">
  <button
    class="hamburger-btn"
    id="hamburger-menu"
    aria-controls="nav-links"
    aria-expanded="false"
    aria-label="Abrir menú de navegación"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
      <line x1="3" y1="6" x2="21" y2="6" />
      <line x1="3" y1="12" x2="21" y2="12" />
      <line x1="3" y1="18" x2="21" y2="18" />
    </svg>
  </button>

  <a href="/" class="navbar-brand">
    <span class="brand-title">PEPON</span>
    <span class="brand-subtitle">PIZZERÍA &amp; ROTISERÍA</span>
  </a>

  <div class="navbar-actions">
    <ThemeToggle />
    <button class="cart-btn" aria-label="Carrito de compras">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="9" cy="21" r="1" />
        <circle cx="20" cy="21" r="1" />
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
      </svg>
      <span class="cart-divider" aria-hidden="true"></span>
      <span class="cart-badge" aria-label="2 productos">2</span>
      <span class="cart-total">$ 15.800</span>
    </button>
  </div>

  <div id="nav-links" class="nav-panel">
    <ul class="nav-links" role="list">
      <li><a href="#inicio">Inicio</a></li>
      <li><a href="#conocenos">Conócenos</a></li>
      <li><a href="#menu">Menú</a></li>
      <li><a href="#sucursal">Sucursal</a></li>
    </ul>
  </div>
</nav>

<script>
  import { initMobileMenu } from "../scripts/navbar-menu";
  import { initActiveNav } from "../scripts/active-nav";

  const disconnectMobile = initMobileMenu();
  const disconnectNav = initActiveNav();

  function cleanup() {
    disconnectMobile();
    disconnectNav();
    document.removeEventListener("astro:before-swap", cleanup);
  }

  document.addEventListener("astro:before-swap", cleanup);
</script>
