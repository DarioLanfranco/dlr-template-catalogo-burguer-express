---
/*
 *  ⚠️  GitHub Pages — Links entre páginas
 *
 *  En prod la `base` es "/dlr-template-catalogo-burguer-express/".
 *  Usamos `import.meta.env.BASE_URL` para rutas absolutas que
 *  funcionan tanto en dev (/) como en prod (/repo/).
 *
 *  Ejemplo:
 *    href={import.meta.env.BASE_URL + "menu/"}
 *    → dev:  /menu/
 *    → prod: /dlr-template-catalogo-burguer-express/menu/
 *
 *  Alternativa: rutas relativas (../menu/) — también funcionan
 *  porque Astro genera index.html dentro de cada subcarpeta.
 */

import ThemeToggle from "./common/ThemeToggle.astro";

const BASE = import.meta.env.BASE_URL;
---

<nav class="navbar" aria-label="Navegación principal">
  <button
    class="hamburger-btn"
    id="hamburger-menu"
    aria-controls="nav-links"
    aria-expanded="false"
    aria-label="Abrir menú de navegación"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
      <line x1="3" y1="6" x2="21" y2="6" />
      <line x1="3" y1="12" x2="21" y2="12" />
      <line x1="3" y1="18" x2="21" y2="18" />
    </svg>
  </button>

  <a href={BASE} class="navbar-brand">
    <span class="brand-title">PEPON</span>
    <span class="brand-subtitle">PIZZERÍA &amp; ROTISERÍA</span>
  </a>

  <div class="navbar-actions">
    <ThemeToggle />
    <button class="cart-btn" aria-label="Carrito de compras">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="9" cy="21" r="1" />
        <circle cx="20" cy="21" r="1" />
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
      </svg>
      <span class="cart-divider" aria-hidden="true"></span>
      <span class="cart-badge" aria-label="0 productos">0</span>
      <span class="cart-total">$ 0</span>
    </button>
  </div>

  <div id="nav-links" class="nav-panel">
    <ul class="nav-links" role="list">
      <li><a href={BASE}>Inicio</a></li>
      <li><a href={BASE + "conocenos/"}>Conócenos</a></li>
      <li><a href={BASE + "menu/"}>Menú</a></li>
      <li><a href={BASE + "promos/"}>Promos</a></li>
    </ul>
  </div>
</nav>

<script>
  import { initMobileMenu } from "../scripts/navbar-menu";
  import { totalItems, total } from "../store/cart";
  import { formatPrice } from "../lib/checkout";

  const disconnectMobile = initMobileMenu();

  const cartBtn = document.querySelector(".cart-btn") as HTMLElement | null;
  const badge = document.querySelector(".cart-badge") as HTMLElement | null;
  const totalEl = document.querySelector(".cart-total") as HTMLElement | null;

  function updateCartDisplay(): void {
    const count = totalItems.get();
    const price = total.get();

    if (badge) {
      badge.textContent = String(count);
      badge.setAttribute("aria-label", `${count} producto${count !== 1 ? "s" : ""}`);
      badge.classList.toggle("is-hidden", count === 0);
    }
    if (totalEl) totalEl.textContent = formatPrice(price);
  }

  cartBtn?.addEventListener("click", () => {
    const target = document.getElementById("checkout-form-section");
    if (target) {
      target.scrollIntoView({ behavior: "smooth", block: "start" });
      const input = target.querySelector("#customer-name") as HTMLElement | null;
      setTimeout(() => input?.focus(), 500);
    }
  });

  const unsubItems = totalItems.subscribe(updateCartDisplay);
  const unsubTotal = total.subscribe(updateCartDisplay);

  updateCartDisplay();

  function cleanup() {
    disconnectMobile();
    unsubItems();
    unsubTotal();
    cartBtn?.removeEventListener("click", updateCartDisplay);
    document.removeEventListener("astro:before-swap", cleanup);
  }

  document.addEventListener("astro:before-swap", cleanup);
</script>

<style>
  /* ==============================================
   *  NAVBAR — PEPÓN
   *  Flexbox: hamburger | brand | actions
   *  ============================================*/

  .navbar {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: 100%;
    height: 72px;
    padding: 0 1.5rem;
    background: transparent;
    box-sizing: border-box;
  }

  .hamburger-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    background: transparent;
    border: none;
    color: var(--color-text-base);
    cursor: pointer;
    transition: color 0.2s var(--ease-spring);
    justify-self: start;
  }

  .hamburger-btn:hover {
    color: var(--color-primary);
  }

  .hamburger-btn:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .navbar-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    justify-self: center;
    transition: transform 0.3s var(--ease-spring);
  }

  .navbar-brand:hover {
    transform: scale(1.02);
  }

  .brand-title {
    font-family: var(--font-display);
    font-size: 1.625rem;
    letter-spacing: -0.03em;
    line-height: 0.85;
    color: var(--color-text-base);
    text-transform: uppercase;
  }

  .brand-subtitle {
    font-size: 9px;
    letter-spacing: 0.2em;
    color: var(--color-primary);
    text-transform: uppercase;
    line-height: 1.2;
  }

  .navbar-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
    justify-self: end;
  }

  .cart-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: var(--color-primary);
    color: #FFFFFF;
    border: var(--border-brutal);
    box-shadow: var(--shadow-brutal);
    cursor: pointer;
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 700;
    transition: transform 0.1s var(--ease-spring), box-shadow 0.1s var(--ease-spring);
    white-space: nowrap;
  }

  .cart-btn:active {
    transform: translate(3px, 3px);
    box-shadow: 2px 2px 0px var(--color-text-base);
  }

  .cart-btn:focus-visible {
    outline: 2px solid var(--color-text-base);
    outline-offset: 3px;
  }

  .cart-divider {
    width: 1px;
    height: 16px;
    background: color-mix(in srgb, #FFFFFF 30%, transparent);
  }

  .cart-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 4px;
    border-radius: 999px;
    background: var(--color-text-base);
    color: var(--color-primary);
    font-size: 0.6875rem;
    font-weight: 800;
    line-height: 1;
  }

  .cart-badge.is-hidden {
    display: none;
  }

  .cart-total {
    font-size: 0.75rem;
    font-weight: 700;
    opacity: 0.95;
  }

  .nav-panel {
    position: absolute;
    top: 100%;
    left: 16px;
    width: calc(100% - 32px);
    background-color: color-mix(in srgb, var(--color-bg) 85%, transparent);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: var(--border-brutal);
    box-shadow: var(--shadow-brutal);
    z-index: 40;
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    pointer-events: none;
    transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s var(--ease-spring);
  }

  .nav-panel.is-open {
    max-height: 500px;
    opacity: 1;
    pointer-events: auto;
  }

  .nav-links {
    display: flex;
    flex-direction: column;
    list-style: none;
    margin: 0;
    padding: 0.5rem 0;
  }

  .nav-links a {
    display: block;
    padding: 12px 24px;
    color: var(--color-text-base);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9375rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background 0.2s var(--ease-spring), color 0.2s var(--ease-spring);
    border-left: 3px solid transparent;
  }

  .nav-links a:hover,
  .nav-links a:focus-visible {
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    color: var(--color-primary);
    border-left-color: var(--color-primary);
  }

  .nav-links a.active {
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    color: var(--color-primary);
    border-left-color: var(--color-primary);
  }

  @media (max-width: 1399px) {
    .brand-title {
      font-size: 1.5rem;
    }
  }

  @media (max-width: 768px) {
    .navbar {
      height: 64px;
      padding: 0 1rem;
    }

    .brand-title {
      font-size: 1.25rem;
    }

    .brand-subtitle {
      font-size: 8px;
    }

    .navbar-actions {
      gap: 0.5rem;
    }

    .cart-btn {
      padding: 0.4rem 0.5rem;
      gap: 0.35rem;
    }

    .cart-total {
      display: none;
    }

    .cart-divider {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hamburger-btn svg line {
      transition: transform 0.3s var(--ease-spring), opacity 0.3s var(--ease-spring);
    }

    .hamburger-btn.is-open svg line:nth-child(1) {
      transform: translateY(6px) rotate(45deg);
    }

    .hamburger-btn.is-open svg line:nth-child(2) {
      opacity: 0;
    }

    .hamburger-btn.is-open svg line:nth-child(3) {
      transform: translateY(-6px) rotate(-45deg);
    }
  }
</style>
