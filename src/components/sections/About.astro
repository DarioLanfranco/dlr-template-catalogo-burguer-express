---
import { Image } from "astro:assets";
import peponlugar from "../../assets/images/peponlugar.webp";

interface Props {
  subtitle: string;
  title: string;
  text1: string;
  text2: string;
}

const { subtitle, title, text1, text2 } = Astro.props;
---

<section id="conocenos" class="about reveal-on-scroll">
  <div class="about-content">
    <div class="about-text">
      <p class="subtitle reveal-on-scroll">{subtitle}</p>
      <h2 class="reveal-on-scroll">{title.toUpperCase()}</h2>
      <p class="reveal-on-scroll">{text1}</p>
      <p class="reveal-on-scroll">{text2}</p>
    </div>
    <div class="about-image reveal-on-scroll media-card">
      <Image
        src={peponlugar}
        alt="Historia de PEPÓN"
        width={800}
        height={600}
        format="webp"
        quality={75}
        loading="lazy"
      />
    </div>
  </div>
</section>

<style>
  .about {
    padding: 6rem 2rem;
    max-width: 1400px;
    margin: 0 auto;
  }

  .about-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .about-text .subtitle {
    display: inline-flex;
    padding: 0.25rem 0.75rem;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-bg);
    background: var(--color-primary);
    border: var(--border-brutal);
    margin-bottom: 1.5rem;
  }

  .about-text h2 {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 0.9;
    margin-bottom: 2rem;
    color: var(--color-text-base);
  }

  .about-text p {
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
    color: var(--color-text-base);
    opacity: 0.85;
  }

  .about-image {
    border: var(--border-brutal);
    box-shadow: var(--shadow-brutal);
  }

  .about-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 1399px) {
    .about {
      padding: 4rem 2rem;
    }

    .about-content {
      gap: 2.5rem;
    }

    .about-text h2 {
      font-size: 2.25rem;
    }
  }

  @media (max-width: 768px) {
    .about {
      padding: 4rem 1.5rem;
    }

    .about-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .about-text h2 {
      font-size: 2rem;
    }
  }
</style>
