---
import { Image } from "astro:assets";
import pizzaClasica from "../../assets/images/pizzaclasica.webp";

interface Props {
  title: string;
  text: string;
}

const { title, text } = Astro.props;
---

<section id="mision" class="mission reveal-on-scroll">
  <div class="mission-content">
    <div class="mission-text reveal-on-scroll">
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="mission-image reveal-on-scroll media-card">
      <Image
        src={pizzaClasica}
        alt="Misión de PEPÓN"
        width={800}
        height={600}
        format="webp"
        quality={75}
        loading="lazy"
      />
    </div>
  </div>
</section>

<style>
  .mission {
    padding: 6rem 2rem;
    max-width: 1400px;
    margin: 0 auto;
    background-color: var(--color-primary);
    border-radius: 1rem;
  }

  .mission-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .mission-text h2 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 2rem;
    color: var(--color-bg);
  }

  .mission-text p {
    font-size: 1.125rem;
    line-height: 1.8;
    margin-bottom: 1.5rem;
    color: var(--color-bg);
  }

  .mission-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 1399px) {
    .mission {
      padding: 4rem 2rem;
    }

    .mission-content {
      gap: 2.5rem;
    }

    .mission-text h2 {
      font-size: 2.25rem;
    }
  }

  @media (max-width: 768px) {
    .mission {
      padding: 4rem 1.5rem;
    }

    .mission-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .mission-text h2 {
      font-size: 2rem;
    }
  }
</style>
