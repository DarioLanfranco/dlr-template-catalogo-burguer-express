---
import VarietyRow from "../ui/VarietyRow.astro";

const BASE = import.meta.env.BASE_URL;
---

<section class="fries-banner">
  <div class="fries-content">
    <h2 class="fries-title">
      ¿CON HAMBRE<br />
      DE <span class="fries-highlight">ALGO MÁS</span>?
    </h2>
    <p class="fries-desc">
      Elegí tu porción de papas y tuneala como quieras: Clásica, con Cheddar fundido, Salsa de Verdeo o nuestras Salsas Brutas. Pedí la tuya y sumala al bajón.
    </p>
    <a href={BASE + "menu/"} class="fries-cta">PEDÍ TU PORCIÓN</a>
  </div>
  <div class="fries-varieties" aria-hidden="true">
    <VarietyRow name="PAPAS CLÁSICAS" />
    <VarietyRow name="PAPAS CON CHEDDAR" />
    <VarietyRow name="PAPAS CON VERDEO" />
    <VarietyRow name="PAPAS CON SALSAS PEPONAS" />
  </div>
</section>

<style>
  .fries-banner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 2rem;
    background: var(--color-bg-base);
    color: #FFFFFF;
  }

  .fries-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .fries-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: #FFFFFF;
    margin: 0;
  }

  .fries-highlight {
    color: var(--color-primary);
  }

  .fries-desc {
    font-size: 0.875rem;
    line-height: 1.7;
    color: #FFFFFF;
    opacity: 0.75;
    margin: 0;
    max-width: 44ch;
  }

  .fries-cta {
    display: inline-flex;
    align-self: flex-start;
    font-family: var(--font-display);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.85rem 2rem;
    background: var(--color-primary);
    color: #FFFFFF;
    border: var(--border-brutal);
    cursor: pointer;
    transition: transform 0.08s ease;
  }

  .fries-cta:active {
    transform: scale(0.96);
  }

  .fries-varieties {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  @media (max-width: 768px) {
    .fries-banner {
      grid-template-columns: 1fr;
      text-align: center;
      padding: 3rem 1.25rem;
      gap: 2.5rem;
    }

    .fries-cta {
      align-self: center;
    }

    .fries-desc {
      max-width: none;
    }
  }

  @media (max-width: 1399px) and (min-width: 769px) {
    .fries-banner {
      padding: 3.5rem 1.5rem;
      gap: 2rem;
    }
  }
</style>
