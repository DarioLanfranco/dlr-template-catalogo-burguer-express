---
interface Props {
  address: string;
}

const { address } = Astro.props;
---

<section class="take-away-banner">
  <div class="take-away-text">
    <h2 class="take-away-title">PASÁ A BUSCARLO</h2>
    <p class="take-away-desc">
      Ahorrá tiempo. Hacé tu pedido por la app, te avisamos por WhatsApp cuando esté listo y lo retirás por la cocina sin esperar un segundo más de la cuenta.
    </p>
    <div class="take-away-meta">
      <span class="take-away-label">DIRECCIÓN</span>
      <span class="take-away-value">{address}</span>
    </div>
    <div class="take-away-meta">
      <span class="take-away-label">HORARIO TAKE AWAY</span>
      <span class="take-away-value">MIÉ — DOM · 20:00 – 00:00</span>
    </div>
  </div>
  <div class="take-away-map" aria-hidden="true">
    <div class="map-placeholder">
      <svg class="map-grid-icon" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
        <circle cx="12" cy="10" r="3"/>
      </svg>
      <span class="map-label">{address}</span>
      <div class="map-grid">
        <span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span>
      </div>
    </div>
  </div>
</section>

<style>
  .take-away-banner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: center;
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 2rem;
    background: var(--color-card-base);
    border: var(--border-brutal);
    box-shadow: var(--shadow-brutal);
    border-radius: 1rem;
  }

  .take-away-text {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .take-away-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--color-text-base);
    margin: 0;
  }

  .take-away-desc {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--color-text-base);
    opacity: 0.75;
    margin: 0 0 0.5rem;
  }

  .take-away-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .take-away-label {
    font-family: var(--font-display);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .take-away-value {
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-text-base);
  }

  .take-away-map {
    width: 100%;
    aspect-ratio: 4 / 3;
  }

  .map-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    background: var(--color-card-base);
    border: var(--border-brutal);
    border-radius: 0.5rem;
    color: #FFFFFF;
    position: relative;
    overflow: hidden;
  }

  .map-grid-icon {
    opacity: 0.6;
    z-index: 1;
  }

  .map-label {
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #FFFFFF;
    opacity: 0.5;
    z-index: 1;
  }

  .map-grid {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(4, 1fr);
    gap: 1px;
    padding: 1rem;
    opacity: 0.12;
    pointer-events: none;
  }

  .map-grid span {
    border: 1px solid #FFFFFF;
  }

  @media (max-width: 768px) {
    .take-away-banner {
      grid-template-columns: 1fr;
      text-align: center;
      padding: 2rem 1.25rem;
      gap: 2rem;
    }

    .take-away-map {
      aspect-ratio: 16 / 9;
    }

    .take-away-meta {
      align-items: center;
    }
  }

  @media (max-width: 1399px) and (min-width: 769px) {
    .take-away-banner {
      padding: 2.5rem 1.5rem;
    }
  }
</style>
