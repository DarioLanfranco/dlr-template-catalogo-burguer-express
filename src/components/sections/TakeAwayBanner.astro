---
interface Props {
  address: string;
}

const { address } = Astro.props;
---

<section class="take-away-banner">
  <div class="take-away-text">
    <h2 class="take-away-title">PASÁ A BUSCARLO</h2>
    <p class="take-away-desc">
      Ahorrá tiempo. Hacé tu pedido por la app, te avisamos por WhatsApp cuando esté listo y lo retirás por la cocina sin esperar un segundo más de la cuenta.
    </p>
    <div class="take-away-meta">
      <span class="take-away-label">DIRECCIÓN</span>
      <span class="take-away-value">{address}</span>
    </div>
    <div class="take-away-meta">
      <span class="take-away-label">HORARIO TAKE AWAY</span>
      <span class="take-away-value">MIÉ — DOM · 20:00 – 00:00</span>
    </div>
  </div>
  <div class="take-away-map">
    <iframe
      class="map-iframe"
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3284.0052995433175!2d-58.3841348!3d-34.6040275!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x95bccac59a5bd441%3A0x1408e2f06974627!2sAv.%20Corrientes%201234%2C%20C1043AAZ%20Cdad.%20Aut%C3%B3noma%20de%20Buenos%20Aires!5e0!3m2!1ses!2sar!4v1780673484294!5m2!1ses!2sar"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
      title="Mapa de ubicación — Av. Corrientes 1234, CABA"
    ></iframe>
  </div>
</section>

<style>
  .take-away-banner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: center;
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 2rem;
    background: var(--color-card-base);
    border: var(--border-brutal);
    box-shadow: var(--shadow-brutal);
    border-radius: 1rem;
  }

  .take-away-text {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .take-away-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--color-text-base);
    margin: 0;
  }

  .take-away-desc {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--color-text-base);
    opacity: 0.75;
    margin: 0 0 0.5rem;
  }

  .take-away-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .take-away-label {
    font-family: var(--font-display);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .take-away-value {
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-text-base);
  }

  .take-away-map {
    width: 100%;
    min-height: 350px;
    border-radius: 0.5rem;
    overflow: hidden;
    border: var(--border-brutal);
  }

  .map-iframe {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 350px;
    border: 0;
    filter: grayscale(1) invert(0.9) hue-rotate(180deg) contrast(1.1);
  }

  @media (max-width: 768px) {
    .take-away-banner {
      grid-template-columns: 1fr;
      text-align: center;
      padding: 2rem 1.25rem;
      gap: 2rem;
    }

    .take-away-map {
      min-height: 260px;
    }

    .take-away-meta {
      align-items: center;
    }
  }

  @media (max-width: 1399px) and (min-width: 769px) {
    .take-away-banner {
      padding: 2.5rem 1.5rem;
    }
  }
</style>
