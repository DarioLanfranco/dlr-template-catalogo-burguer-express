---
interface Props {
  siteName: string;
}

const { siteName } = Astro.props;
---

<footer>
  <p>
    &copy; 2026 Copyright {siteName}. Todos los derechos
    reservados. Desarrollado por Dario Lanfranco
  </p>
</footer>

<style>
  footer {
    padding: 2rem;
    text-align: center;
    border-top: var(--border-brutal);
  }

  footer p {
    color: var(--color-text-base);
    opacity: 0.6;
    font-size: 0.8125rem;
  }
</style>
