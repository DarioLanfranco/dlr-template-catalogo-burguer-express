---
import { Image } from "astro:assets";
import headBurgerImg from "../../assets/images/headburguer.webp";

const BASE = import.meta.env.BASE_URL;
---

<section id="inicio" class="hero">
  <div class="hero-text">
    <span class="hero-sticker">RÁPIDO, CALIENTE Y BRUTAL</span>

    <h1 class="hero-title">
      LA MEJOR<br />
      <span class="hero-highlight">COMIDA</span><br />
      DE LA CIUDAD
    </h1>

    <p class="hero-desc">
      Hamburguesas, pizzas, empanadas y mucho más. Pedí fácil, rápido y disfrutá
      donde estés.
    </p>

    <div class="hero-actions">
      <a href={BASE + "menu/"} class="btn-order">
        <svg class="btn-delivery-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="9" cy="21" r="1" />
          <circle cx="20" cy="21" r="1" />
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
        </svg>
        PEDÍ AHORA
      </a>
    </div>
  </div>

  <div class="hero-visual">
    <div class="hero-image-frame">
      <Image
        src={headBurgerImg}
        alt="Hamburguesa PEPÓN"
        width={800}
        fit="contain"
        format="webp"
        quality={90}
        loading="eager"
        fetchpriority="high"
        class="hero-burger"
      />

      <div class="sticker-love">
        <span aria-hidden="true">❤️</span>
        HECHA CON AMOR
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 3rem;
    align-items: center;
    max-width: 1400px;
    margin: 0 auto;
    padding: 4rem 2rem 6rem;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .hero-sticker {
    display: inline-flex;
    align-self: flex-start;
    padding: 0.4rem 1rem;
    background: var(--color-secondary);
    color: #121212;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border: var(--border-brutal);
    transform: rotate(-3deg);
    transform-origin: left center;
    white-space: nowrap;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    letter-spacing: -0.03em;
    line-height: 0.95;
    color: var(--color-text-base);
    text-transform: uppercase;
    margin: 0;
  }

  .hero-highlight {
    color: var(--color-primary);
  }

  .hero-desc {
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.6;
    color: var(--color-text-base);
    opacity: 0.85;
    max-width: 40ch;
    margin: 0;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .btn-order {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.75rem;
    background: var(--color-primary);
    color: #ffffff;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 900;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-decoration: none;
    border: var(--border-brutal);
    box-shadow: var(--shadow-brutal);
    cursor: pointer;
  }

  .btn-order:active {
    transform: translate(3px, 3px);
    box-shadow: 2px 2px 0px var(--color-text-base);
  }

  .btn-order:focus-visible {
    outline: 2px solid var(--color-text-base);
    outline-offset: 4px;
  }

  .btn-delivery-icon {
    flex-shrink: 0;
  }

  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-image-frame {
    position: relative;
    width: 100%;
    max-width: 700px;
  }

  .hero-burger {
    display: block;
    width: 100%;
    height: auto;
  }

  .sticker-love {
    position: absolute;
    bottom: 6%;
    left: -4%;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 1rem;
    background: var(--color-text-base);
    color: var(--color-bg);
    font-family: var(--font-display);
    font-size: clamp(0.65rem, 1.5vw, 0.75rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    border-radius: 999px;
    border: var(--border-brutal);
    transform: rotate(-6deg);
    white-space: nowrap;
    z-index: 2;
  }

  .sticker-love span {
    font-size: clamp(0.65rem, 1.5vw, 0.8rem);
    line-height: 1;
    flex-shrink: 0;
  }

  @media (min-width: 769px) and (max-width: 1399px) {
    .hero {
      gap: 2rem;
      padding: 2rem 2rem 4rem;
    }
  }

  @media (max-width: 768px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding: 1.5rem 1.25rem 3rem;
    }

    .hero-text {
      gap: 1.25rem;
      align-items: center;
      text-align: center;
    }

    .hero-sticker {
      align-self: center;
      font-size: 0.65rem;
    }

    .hero-desc {
      max-width: none;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-image-frame {
      max-width: none;
    }

    .sticker-love {
      bottom: 4%;
      left: -2%;
    }
  }

  @media (max-width: 420px) {
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .btn-order {
      width: 100%;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .btn-order {
      transition:
        transform 0.1s var(--ease-spring),
        box-shadow 0.1s var(--ease-spring);
    }
  }
</style>
