---
import { Image } from "astro:assets";
import { siteConfig } from "../config/site-config";
import headBurgerImg from "../assets/images/headburguer.webp";

interface ImageMetadata {
  src: string;
  width: number;
  height: number;
  format: "avif" | "png" | "webp" | "jpeg" | "jpg" | "svg" | "tiff" | "gif";
  orientation?: number;
}

interface PromoData {
  sticker: string;
  title: string;
  highlight: string;
  desc: string;
  price: number;
  img: ImageMetadata;
  imgAlt: string;
}

interface Props {
  whatsappNumber?: string;
  promo?: Partial<PromoData>;
}

const { whatsappNumber = siteConfig.contact.whatsappNumber, promo = {} } = Astro.props;

const data: PromoData = {
  sticker: "PROMO",
  title: "COMBO",
  highlight: "PEPON",
  desc: "BURGER DOBLE + PAPAS + GASEOSA 350ML",
  price: 12500,
  img: headBurgerImg,
  imgAlt: "Hamburguesa Combo Pepón",
  ...promo,
};
---

<section id="combo-promo" class="promo-section" data-whatsapp={whatsappNumber} data-site={siteConfig.siteName}>
  <div class="promo-banner">
    <div class="promo-left">
      <span class="promo-sticker">{data.sticker}</span>
      <h2 class="promo-title">
        {data.title}<br />
        <span class="promo-highlight">{data.highlight}</span>
      </h2>
      <p class="promo-desc">{data.desc}</p>
      <div class="promo-price-box">
        <span class="promo-price">$ {data.price.toLocaleString("es-AR")}</span>
      </div>
    </div>

    <div class="promo-right">
      <div class="promo-composition">
        <Image
          src={data.img}
          alt={data.imgAlt}
          width={500}
          height={400}
          format="webp"
          quality={80}
          loading="lazy"
          class="promo-burger"
        />

        <svg class="promo-fries" viewBox="0 0 80 100" fill="none" aria-hidden="true">
          <rect x="8" y="15" width="14" height="58" rx="5" fill="#FFC300" stroke="var(--color-text-base)" stroke-width="3"/>
          <rect x="24" y="5" width="14" height="68" rx="5" fill="#FFC300" stroke="var(--color-text-base)" stroke-width="3"/>
          <rect x="40" y="22" width="14" height="51" rx="5" fill="#FFC300" stroke="var(--color-text-base)" stroke-width="3"/>
          <rect x="56" y="12" width="14" height="61" rx="5" fill="#FFC300" stroke="var(--color-text-base)" stroke-width="3"/>
          <ellipse cx="15" cy="18" rx="5" ry="4" fill="#E63946"/>
          <ellipse cx="31" cy="10" rx="5" ry="4" fill="#E63946"/>
          <ellipse cx="47" cy="25" rx="5" ry="4" fill="#E63946"/>
          <ellipse cx="63" cy="16" rx="5" ry="4" fill="#E63946"/>
        </svg>

        <svg class="promo-soda" viewBox="0 0 50 90" fill="none" aria-hidden="true">
          <rect x="5" y="12" width="40" height="64" rx="6" fill="#E63946" stroke="var(--color-text-base)" stroke-width="3"/>
          <rect x="2" y="9" width="46" height="8" rx="4" fill="#D3D3D3" stroke="var(--color-text-base)" stroke-width="2.5"/>
          <rect x="5" y="24" width="40" height="22" fill="#FFFFFF" stroke="var(--color-text-base)" stroke-width="0"/>
          <rect x="5" y="24" width="40" height="6" fill="#FFC300"/>
          <text x="25" y="39" text-anchor="middle" font-size="9" font-weight="900" fill="var(--color-text-base)" font-family="Impact, sans-serif">COLA</text>
          <ellipse cx="25" cy="7" rx="6" ry="3" fill="#D3D3D3" stroke="var(--color-text-base)" stroke-width="2"/>
          <rect x="5" y="68" width="40" height="8" rx="4" fill="#D3D3D3" stroke="var(--color-text-base)" stroke-width="2.5"/>
        </svg>
      </div>
    </div>
  </div>

  <div class="checkout-bar">
    <button
      type="button"
      class="checkout-btn btn-brutal-heavy"
      id="quick-checkout-btn"
      aria-label="Confirmar pedido por WhatsApp"
    >
      <span class="checkout-text">
        CONFIRMAR PEDIDO
        <small class="checkout-sub">(ENVIAR A WHATSAPP)</small>
      </span>
      <span class="checkout-total" id="quick-checkout-total">$ 0</span>
    </button>
  </div>

  <div id="quick-fallback" class="quick-fallback" role="alert" hidden>
    <p class="fallback-message">No se pudo abrir WhatsApp automáticamente.</p>
    <a id="quick-fallback-link" class="fallback-link" href="#" target="_blank" rel="noopener">
      Hacé click acá para enviar el pedido →
    </a>
  </div>
</section>

<script>
  import { cartItems, total, isCartValid, clearCart } from "../store/cart";
  import { buildQuickOrderMessage, getWhatsAppUrl } from "../services/orderService";
  import { formatPrice } from "../lib/checkout";

  const section = document.querySelector(".promo-section") as HTMLElement | null;
  const phoneNumber = section?.dataset.whatsapp ?? "";
  const siteName = section?.dataset.site ?? "PEPÓN";
  const btn = document.getElementById("quick-checkout-btn") as HTMLButtonElement | null;
  const totalDisplay = document.getElementById("quick-checkout-total") as HTMLElement | null;
  const fallbackEl = document.getElementById("quick-fallback") as HTMLElement | null;
  const fallbackLink = document.getElementById("quick-fallback-link") as HTMLAnchorElement | null;

  let isSubmitting = false;

  function updateCheckout(): void {
    const valid = isCartValid.get();
    const totalValue = total.get();

    if (totalDisplay) totalDisplay.textContent = formatPrice(totalValue);
    if (btn) btn.disabled = !valid;
  }

  function handleQuickCheckout(): void {
    if (isSubmitting || !btn) return;

    const items = cartItems.get();
    if (items.length === 0) {
      alert("Agregá productos al carrito antes de confirmar.");
      return;
    }

    isSubmitting = true;
    btn.disabled = true;
    if (fallbackEl) fallbackEl.hidden = true;

    const totalValue = total.get();
    const message = buildQuickOrderMessage(items, totalValue, siteName);
    const url = getWhatsAppUrl(phoneNumber, message);

    const win = window.open(url, "_blank");
    if (win) {
      clearCart();
    } else {
      isSubmitting = false;
      btn.disabled = false;
      if (fallbackLink && fallbackEl) {
        fallbackLink.href = url;
        fallbackEl.hidden = false;
      }
    }
  }

  btn?.addEventListener("click", handleQuickCheckout);

  const unsubItems = total.subscribe(updateCheckout);
  const unsubValid = isCartValid.subscribe(updateCheckout);
  updateCheckout();

  function cleanup(): void {
    unsubItems();
    unsubValid();
    btn?.removeEventListener("click", handleQuickCheckout);
    document.removeEventListener("astro:before-swap", cleanup);
  }

  document.addEventListener("astro:before-swap", cleanup);
</script>

<style>
  .promo-section {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem 3rem;
  }

  .promo-banner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: center;
    background: var(--color-secondary);
    border: var(--border-brutal-heavy);
    box-shadow: var(--shadow-brutal-heavy);
    padding: 2.5rem 2.5rem;
    overflow: hidden;
  }

  .promo-left {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .promo-sticker {
    display: inline-flex;
    align-self: flex-start;
    padding: 0.35rem 0.75rem;
    background: #121212;
    color: #FFFFFF;
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    border: 3px solid #FFFFFF;
    transform: rotate(-2deg);
    transform-origin: left center;
    white-space: nowrap;
  }

  .promo-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    letter-spacing: -0.04em;
    line-height: 0.85;
    color: #121212;
    text-transform: uppercase;
    margin: 0;
  }

  .promo-highlight {
    color: var(--color-primary);
  }

  .promo-desc {
    font-size: clamp(0.85rem, 1.4vw, 1.05rem);
    font-weight: 800;
    letter-spacing: 0.02em;
    color: #121212;
    line-height: 1.3;
    margin: 0;
    text-wrap: balance;
  }

  .promo-price-box {
    display: inline-flex;
    align-self: flex-start;
    padding: 0.6rem 1.5rem;
    background: #FFFFFF;
    border: var(--border-brutal);
    box-shadow: var(--shadow-brutal);
  }

  .promo-price {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--color-primary);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .promo-right {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .promo-composition {
    position: relative;
    width: 100%;
    max-width: 480px;
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .promo-burger {
    width: 75%;
    height: auto;
    object-fit: contain;
    position: relative;
    z-index: 2;
    filter: drop-shadow(4px 4px 0px var(--color-text-base));
  }

  .promo-fries {
    position: absolute;
    left: 0;
    bottom: 2%;
    width: clamp(80px, 18vw, 140px);
    height: auto;
    z-index: 3;
    transform: rotate(-8deg);
    filter: drop-shadow(3px 3px 0px var(--color-text-base));
  }

  .promo-soda {
    position: absolute;
    right: 2%;
    bottom: 0;
    width: clamp(50px, 12vw, 90px);
    height: auto;
    z-index: 1;
    transform: rotate(6deg);
    filter: drop-shadow(3px 3px 0px var(--color-text-base));
  }

  .checkout-bar {
    margin-top: 1.75rem;
  }

  .checkout-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 1rem 1.75rem;
    background: var(--color-primary);
    color: #FFFFFF;
    text-decoration: none;
    cursor: pointer;
    gap: 1rem;
    font-family: inherit;
    font-size: inherit;
    border: none;
  }

  .checkout-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .checkout-btn:not(:disabled):active {
    transform: translate(4px, 4px);
    box-shadow: 2px 2px 0px var(--color-text-base);
  }

  .checkout-btn:focus-visible {
    outline: 2px solid var(--color-text-base);
    outline-offset: 4px;
  }

  .checkout-text {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 1.6vw, 1.2rem);
    letter-spacing: 0.02em;
    text-align: left;
  }

  .checkout-sub {
    font-family: "Inter Variable", Inter, sans-serif;
    font-size: 0.7em;
    font-weight: 600;
    opacity: 0.85;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .checkout-total {
    flex-shrink: 0;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    letter-spacing: -0.02em;
    color: #FFFFFF;
  }

  @media (max-width: 1399px) {
    .promo-section {
      padding: 0 1.5rem 2.5rem;
    }

    .promo-banner {
      padding: 2rem;
      gap: 1.5rem;
    }
  }

  @media (max-width: 768px) {
    .promo-section {
      padding: 0 1.25rem 2rem;
    }

    .promo-banner {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 1.75rem 1.25rem;
    }

    .promo-left {
      align-items: flex-start;
    }

    .promo-sticker {
      align-self: flex-start;
    }

    .promo-desc {
      text-wrap: pretty;
    }

    .promo-composition {
      aspect-ratio: 5 / 3;
      max-width: 360px;
      margin: 0 auto;
    }

    .promo-fries {
      width: clamp(70px, 22vw, 110px);
    }

    .promo-soda {
      width: clamp(40px, 15vw, 70px);
    }

    .checkout-btn {
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      padding: 1rem 1.25rem;
    }

    .checkout-text {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 0.2rem;
    }
  }

  @media (max-width: 420px) {
    .promo-banner {
      padding: 1.25rem 1rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .checkout-btn {
      transition: opacity 0.15s ease, transform 0.1s var(--ease-spring);
    }
  }

  .quick-fallback {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    border: 2px solid var(--color-primary);
    border-radius: 0.25rem;
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    text-align: center;
  }
</style>
