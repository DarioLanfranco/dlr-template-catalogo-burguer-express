---
import { Image } from "astro:assets";
import { siteConfig } from "../config/site-config";
import promoImg from "../assets/images/promo.webp";

interface Props {
  whatsappNumber?: string;
}

const { whatsappNumber = siteConfig.contact.whatsappNumber } = Astro.props;
---

<section
  id="combo-promo"
  class="promo-section"
  data-whatsapp={whatsappNumber}
  data-site={siteConfig.siteName}
>
  <div class="promo-banner">
    <div class="promo-left">
      <span class="promo-sticker">PROMO</span>
      <h2 class="promo-title">
        COMBO<br />
        <span class="promo-highlight">PEPON</span>
      </h2>
      <p class="promo-desc">BURGER DOBLE + PAPAS + GASEOSA 350ML</p>
      <div class="promo-price-box">
        <span class="promo-price">$ 12.500</span>
      </div>
    </div>

    <div class="promo-right">
      <div class="promo-composition">
        <span class="promo-badge">PROMO BIEN PEPON</span>
        <Image
          src={promoImg}
          alt="Combo Pepón: hamburguesa doble, papas fritas y gaseosa"
          class="promo-img"
          loading="lazy"
        />
      </div>
    </div>
  </div>

  <div class="checkout-bar">
    <button
      type="button"
      class="checkout-btn btn-brutal-heavy"
      id="quick-checkout-btn"
      aria-label="Confirmar pedido por WhatsApp"
    >
      <span class="checkout-text">
        CONFIRMAR PEDIDO
        <small class="checkout-sub">(ENVIAR A WHATSAPP)</small>
      </span>
      <span class="checkout-total" id="quick-checkout-total">$ 0</span>
    </button>
  </div>

  <div id="quick-fallback" class="quick-fallback" role="alert" hidden>
    <p class="fallback-message">No se pudo abrir WhatsApp automáticamente.</p>
    <a
      id="quick-fallback-link"
      class="fallback-link"
      href="#"
      target="_blank"
      rel="noopener"
    >
      Hacé click acá para enviar el pedido →
    </a>
  </div>
</section>

<script>
  import { cartItems, total, isCartValid, clearCart } from "../store/cart";
  import {
    buildQuickOrderMessage,
    getWhatsAppUrl,
  } from "../services/orderService";
  import { formatPrice } from "../lib/checkout";

  const section = document.querySelector(
    ".promo-section",
  ) as HTMLElement | null;
  const phoneNumber = section?.dataset.whatsapp ?? "";
  const siteName = section?.dataset.site ?? "PEPÓN";
  const btn = document.getElementById(
    "quick-checkout-btn",
  ) as HTMLButtonElement | null;
  const totalDisplay = document.getElementById(
    "quick-checkout-total",
  ) as HTMLElement | null;
  const fallbackEl = document.getElementById(
    "quick-fallback",
  ) as HTMLElement | null;
  const fallbackLink = document.getElementById(
    "quick-fallback-link",
  ) as HTMLAnchorElement | null;

  let isSubmitting = false;

  function updateCheckout(): void {
    const valid = isCartValid.get();
    const totalValue = total.get();

    if (totalDisplay) totalDisplay.textContent = formatPrice(totalValue);
    if (btn) btn.disabled = !valid;
  }

  function handleQuickCheckout(): void {
    if (isSubmitting || !btn) return;

    const items = cartItems.get();
    if (items.length === 0) {
      alert("Agregá productos al carrito antes de confirmar.");
      return;
    }

    isSubmitting = true;
    btn.disabled = true;
    if (fallbackEl) fallbackEl.hidden = true;

    const totalValue = total.get();
    const message = buildQuickOrderMessage(items, totalValue, siteName);
    const url = getWhatsAppUrl(phoneNumber, message);

    const win = window.open(url, "_blank");
    if (win) {
      clearCart();
    } else {
      isSubmitting = false;
      btn.disabled = false;
      if (fallbackLink && fallbackEl) {
        fallbackLink.href = url;
        fallbackEl.hidden = false;
      }
    }
  }

  btn?.addEventListener("click", handleQuickCheckout);

  const unsubItems = total.subscribe(updateCheckout);
  const unsubValid = isCartValid.subscribe(updateCheckout);
  updateCheckout();

  function cleanup(): void {
    unsubItems();
    unsubValid();
    btn?.removeEventListener("click", handleQuickCheckout);
    document.removeEventListener("astro:before-swap", cleanup);
  }

  document.addEventListener("astro:before-swap", cleanup);
</script>

<style>
  .promo-section {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem 3rem;
  }

  .promo-banner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: center;
    background: var(--color-secondary);
    border: var(--border-brutal-heavy);
    box-shadow: var(--shadow-brutal-heavy);
    padding: 3rem 3rem;
    overflow: hidden;
  }

  .promo-left {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .promo-sticker {
    display: inline-flex;
    align-self: flex-start;
    padding: 0.35rem 0.75rem;
    background: #121212;
    color: #ffffff;
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    border: 3px solid #ffffff;
    transform: rotate(-2deg);
    transform-origin: left center;
    white-space: nowrap;
  }

  .promo-title {
    font-family: var(--font-display);
    font-size: clamp(3.25rem, 7vw, 6.5rem);
    letter-spacing: -0.04em;
    line-height: 0.85;
    color: #121212;
    text-transform: uppercase;
    margin: 0;
  }

  .promo-highlight {
    color: var(--color-primary);
  }

  .promo-desc {
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    font-weight: 800;
    letter-spacing: 0.02em;
    color: #121212;
    line-height: 1.3;
    margin: 0;
    text-wrap: balance;
  }

  .promo-price-box {
    display: inline-flex;
    align-self: flex-start;
    padding: 0.6rem 1.5rem;
    background: #ffffff;
    border: var(--border-brutal);
    box-shadow: var(--shadow-brutal);
  }

  .promo-price {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 3rem);
    color: var(--color-primary);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .promo-right {
    display: flex;
    max-width: 1000px;
    justify-content: center;
    align-items: center;
  }

  .promo-composition {
    position: relative;
    width: 100%;
    max-width: 880px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .promo-img {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .promo-badge {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 10;
    padding: 0.3rem 0.75rem;
    background: #121212;
    border: 2px solid #ffffff;
    color: #ffffff;
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    line-height: 1.3;
    pointer-events: none;
  }

  .checkout-bar {
    margin-top: 1.75rem;
  }

  .checkout-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 1rem 1.75rem;
    background: var(--color-primary);
    color: #ffffff;
    text-decoration: none;
    cursor: pointer;
    gap: 1rem;
    font-family: inherit;
    font-size: inherit;
    border: none;
  }

  .checkout-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .checkout-btn:not(:disabled):active {
    transform: translate(4px, 4px);
    box-shadow: 2px 2px 0px var(--color-text-base);
  }

  .checkout-btn:focus-visible {
    outline: 2px solid var(--color-text-base);
    outline-offset: 4px;
  }

  .checkout-text {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 1.6vw, 1.2rem);
    letter-spacing: 0.02em;
    text-align: left;
  }

  .checkout-sub {
    font-family: "Inter Variable", Inter, sans-serif;
    font-size: 0.7em;
    font-weight: 600;
    opacity: 0.85;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .checkout-total {
    flex-shrink: 0;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  @media (max-width: 1399px) {
    .promo-section {
      padding: 0 1.5rem 2.5rem;
    }

    .promo-banner {
      padding: 2.5rem;
      gap: 1.5rem;
    }
  }

  @media (max-width: 768px) {
    .promo-section {
      padding: 0 1.25rem 2rem;
    }

    .promo-banner {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 2rem 1.5rem;
    }

    .promo-left {
      align-items: flex-start;
    }

    .promo-sticker {
      align-self: flex-start;
    }

    .promo-desc {
      text-wrap: pretty;
    }

    .promo-composition {
      max-width: 360px;
      margin: 0 auto;
    }

    .checkout-btn {
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      padding: 1rem 1.25rem;
    }

    .checkout-text {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 0.2rem;
    }
  }

  @media (max-width: 420px) {
    .promo-banner {
      padding: 1.25rem 1rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .checkout-btn {
      transition:
        opacity 0.15s ease,
        transform 0.1s var(--ease-spring);
    }
  }

  .quick-fallback {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    border: 2px solid var(--color-primary);
    border-radius: 0.25rem;
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    text-align: center;
  }
</style>
