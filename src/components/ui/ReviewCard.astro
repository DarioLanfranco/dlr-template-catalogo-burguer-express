---
interface Props {
  rating: string;
  text: string;
  author: string;
}

const { rating, text, author } = Astro.props;
---

<article class="review-card">
  <span class="review-rating">{rating}</span>
  <p class="review-text">{text}</p>
  <footer class="review-author">{author}</footer>
</article>

<style>
  .review-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 0 1 320px;
    padding: 1.5rem;
    background: var(--color-card-base);
    border: var(--border-brutal);
    box-shadow: var(--shadow-brutal);
  }

  .review-rating {
    font-size: 1.125rem;
    letter-spacing: 0.15em;
    color: var(--color-secondary);
    line-height: 1;
  }

  .review-text {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-base);
    opacity: 0.85;
    margin: 0;
    flex: 1;
  }

  .review-author {
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-top: auto;
  }

  @media (max-width: 768px) {
    .review-card {
      flex: none;
      width: 100%;
      max-width: 360px;
    }
  }
</style>
