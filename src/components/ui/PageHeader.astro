---
interface Props {
  title: string;
  highlight: string;
  description: string;
  /** Toggle which part gets highlighted: "first" (default) or "last" */
  highlightPos?: "first" | "last";
}

const { title, highlight, description, highlightPos = "last" } = Astro.props;
---

<section class="page-header">
  <h1 class="page-title">
    {highlightPos === "first" ? (
      <><span class="page-highlight">{highlight}</span><br />{title}</>
    ) : (
      <>{title}<br /><span class="page-highlight">{highlight}</span></>
    )}
  </h1>
  <p class="page-desc">{description}</p>
</section>

<style>
  .page-header {
    max-width: 1400px;
    margin: 0 auto;
    padding: 4rem 2rem 0;
    text-align: center;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    letter-spacing: -0.03em;
    line-height: 0.88;
    color: var(--color-text-base);
    text-transform: uppercase;
    margin: 0 0 1rem;
  }

  .page-highlight {
    color: var(--color-primary);
  }

  .page-desc {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: var(--color-text-base);
    opacity: 0.8;
    max-width: 50ch;
    margin: 0 auto 3rem;
  }

  @media (max-width: 768px) {
    .page-header {
      padding: 2.5rem 1.5rem 0;
    }
  }
</style>
